POSTGRES_PASSWORD=catalog
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Токен бота от @BotFather
BOT_TOKEN=
# Telegram user id администраторов через запятую
ADMIN_IDS=

# Адрес каталога, который открывает кнопка Mini App.
# В Telegram нужен HTTPS. WEBAPP_URL и PUBLIC_API_URL — один и тот же адрес,
# чтобы страница и картинки открывались без смешанного содержимого.
WEBAPP_URL=http://localhost:3000

# Адрес API, с которого браузер и Telegram грузят картинки.
PUBLIC_API_URL=http://localhost:8000

# Пусто — один инстанс бота забирает события через getUpdates.
# Для двух и более реплик укажите публичный HTTPS и один секрет на все реплики.
WEBHOOK_URL=
WEBHOOK_SECRET=
